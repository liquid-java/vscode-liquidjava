{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2019",
		"lib": ["ES2019", "DOM"],
		"types": ["node", "vscode"],
		"outDir": "out",
		"sourceMap": true,
		"rootDir": "src",
		"resolveJsonModule": true
	},
	"exclude": [
		"node_modules",
		".vscode-test",
		"src/**/*.spec.ts",
		"vitest.config.mts"
	]
}
